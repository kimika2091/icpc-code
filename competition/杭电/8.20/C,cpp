#include <bits/stdc++.h>
using namespace std;

struct Dinic {
    struct Edge {
        int to, cap, rev;
    };

    int n;
    vector<vector<Edge>> graph;
    vector<int> level, cur;

    Dinic(int n) : n(n), graph(n), level(n), cur(n) {}

    void addEdge(int from, int to, int cap) {
        Edge forward{to, cap, (int)graph[to].size()};
        Edge backward{from, 0, (int)graph[from].size()};
        graph[from].push_back(forward);
        graph[to].push_back(backward);
    }

    bool bfs(int source, int sink) {
        fill(level.begin(), level.end(), -1);

        queue<int> q;
        q.push(source);
        level[source] = 0;

        while (!q.empty()) {
            int u = q.front();
            q.pop();

            for (const auto &e : graph[u]) {
                if (e.cap > 0 && level[e.to] == -1) {
                    level[e.to] = level[u] + 1;
                    q.push(e.to);
                }
            }
        }

        return level[sink] != -1;
    }

    int dfs(int u, int sink, int flow) {
        if (u == sink) return flow;

        for (int &i = cur[u]; i < (int)graph[u].size(); i++) {
            Edge &e = graph[u][i];

            if (e.cap > 0 && level[e.to] == level[u] + 1) {
                int pushed = dfs(e.to, sink, min(flow, e.cap));

                if (pushed > 0) {
                    e.cap -= pushed;
                    graph[e.to][e.rev].cap += pushed;
                    return pushed;
                }
            }
        }

        return 0;
    }

    int maxFlow(int source, int sink) {
        int result = 0;

        while (bfs(source, sink)) {
            fill(cur.begin(), cur.end(), 0);

            while (int pushed = dfs(source, sink, INT_MAX)) {
                result += pushed;
            }
        }

        return result;
    }
};

void solve() {
    int N, K;
    cin >> N >> K;

    vector<string> accept(N);
    for (string &s : accept) cin >> s;

    auto check = [&](int dorms) {
        int studentStart = 0;
        int bedStart = N;
        int source = N + K;
        int sink = source + 1;

        Dinic dinic(sink + 1);

        for (int i = 0; i < N; i++) {
            dinic.addEdge(source, studentStart + i, 1);

            for (int j = 0; j < K; j++) {
                if (accept[i][j] == '1') {
                    dinic.addEdge(studentStart + i, bedStart + j, 1);
                }
            }
        }

        for (int j = 0; j < K; j++) {
            dinic.addEdge(bedStart + j, sink, dorms);
        }

        return dinic.maxFlow(source, sink) == dorms * K;
    };

    int left = 0;
    int right = N / K;

    while (left < right) {
        int mid = (left + right + 1) / 2;

        if (check(mid)) {
            left = mid;
        } else {
            right = mid - 1;
        }
    }

    cout << left << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        solve();
    }

    return 0;
}